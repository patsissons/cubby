# cubby deployment credentials. Values never live in the repo:
# - PHIO_* go in GitHub repo secrets (for deploy.yml) or your local shell
# - provider API keys go in the PocketHost dashboard, instance Secrets tab
#   (they become env vars for the pocketbase process; restart after changing)

# PocketHost account + instance for phio deploys (CI or local).
PHIO_USERNAME=you@example.com
PHIO_PASSWORD=
PHIO_INSTANCE_NAME=your-instance

# Convenience pointer for scripts/tools; the foundation reads
# cubby.config.json instead.
POCKETHOST_INSTANCE_URL=https://your-instance.pockethost.io

# AI provider keys, set in the PocketHost instance Secrets tab (NOT here).
# Each is optional: the AI proxy returns provider_unconfigured for missing ones.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
