# cubby deployment credentials. Values never live in the repo:
# - PHIO_* go in GitHub repo secrets (for deploy.yml) or your local shell
# - provider API keys go in the PocketHost dashboard, instance Secrets tab
#   (they become env vars for the pocketbase process; restart after changing)

# PocketHost account + instance for phio deploys (CI or local).
PHIO_USERNAME=you@example.com
PHIO_PASSWORD=
PHIO_INSTANCE_NAME=your-instance

# Convenience pointer for scripts/tools; the foundation reads
# cubby.config.json instead.
POCKETHOST_INSTANCE_URL=https://your-instance.pockethost.io

# AI provider key, set in the PocketHost instance Secrets tab (NOT here).
# Every model in cubby.config.json routes through OpenRouter; without the key
# the AI proxy returns provider_unconfigured.
OPENROUTER_API_KEY=

# Bearer token for the platform MCP explorer endpoint (POST /_cubby/mcp),
# read by pb_hooks/mcp.pb.js. Generate with `openssl rand -hex 32`. Set in
# the Secrets tab like the AI key (locally: export before `npm run dev`);
# unset means the endpoint answers not_configured.
CUBBY_MCP_TOKEN=

# App-specific env vars (read by pb_hooks/apps/<app>/ hooks) are prefixed
# with the app's slug in upper snake case, hyphens as underscores, so the
# Secrets tab shows who owns each value. Also set in the Secrets tab, not here.
# HELLO_TEST_VALUE=testing
# HELLO_MCP_TOKEN=            # the app's MCP endpoint, POST /_cubby/mcp/hello
# MY_APP_API_KEY=
