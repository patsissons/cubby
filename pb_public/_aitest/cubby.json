{
  "name": "_aitest",
  "hidden": true,
  "ai": {
    "models": ["gemini-flash"],
    "allowAnonymous": true,
    "rateLimitSeconds": 60,
    "maxChars": 300,
    "maxTokens": 200,
    "messagePatterns": {
      "system": "^You greet people warmly in one short sentence\\.$",
      "user": "^Say hello to .{1,80}!$"
    }
  }
}
