{
  "name": "cubby",
  "title": "Cubby",
  "domain": "https://cubby.pockethost.io",
  "instanceUrl": "https://cubby.pockethost.io",
  "oauthProviders": ["google", "github"],
  "ai": {
    "defaultModel": "deepseek-flash",
    "models": {
      "deepseek-flash": { "provider": "openrouter", "id": "deepseek/deepseek-v4.1-flash" },
      "glm-flash": { "provider": "openrouter", "id": "z-ai/glm-5.3-flash" },
      "gemini-flash": { "provider": "openrouter", "id": "google/gemini-3.8-flash" },
      "gpt-astra": { "provider": "openrouter", "id": "openai/gpt-6-astra" },
      "claude-fable": { "provider": "openrouter", "id": "anthropic/claude-fable-5.1" },
      "claude-opus": { "provider": "openrouter", "id": "anthropic/claude-opus-5" }
    }
  },
  "preview": {
    "frameable": ["pockethost.io"],
    "measured": {
      "pockethost.io": "2026-08-24: no x-frame-options, no frame-ancestors",
      "github.com": "2026-08-24: REFUSED, x-frame-options deny + frame-ancestors none",
      "pocketbase.io": "2026-08-24: REFUSED, x-frame-options SAMEORIGIN"
    }
  },
  "reservedNames": [
    "api",
    "_",
    "js",
    "css",
    "_template",
    "index.html",
    "sites.json",
    "llms.txt",
    "cubby.config.json",
    "icon.svg",
    "og.png",
    "apple-touch-icon.png"
  ]
}
