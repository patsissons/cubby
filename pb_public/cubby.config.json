      "claude-haiku": { "provider": "anthropic", "id": "claude-haiku-4-5" },
      "claude-sonnet": { "provider": "anthropic", "id": "claude-sonnet-5" },
      "gpt-mini": { "provider": "openai", "id": "gpt-5.6-luna" },
      "gpt": { "provider": "openai", "id": "gpt-5.6-sol" }
    }
  },
  "preview": {
    "frameable": ["pockethost.io"],
    "measured": {
      "pockethost.io": "2026-08-24: no x-frame-options, no frame-ancestors",
      "github.com": "2026-08-24: REFUSED, x-frame-options deny + frame-ancestors none",
      "pocketbase.io": "2026-08-24: REFUSED, x-frame-options SAMEORIGIN"
    }
  },
  "reservedNames": [
    "api",
    "_",
    "js",
    "css",
    "_template",
    "index.html",
    "sites.json",
    "cubby.config.json",
    "icon.svg",
    "og.png",
    "apple-touch-icon.png"
  ]
