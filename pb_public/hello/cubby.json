{
  "name": "hello",
  "title": "Hello",
  "description": "The example app: every cubby subsystem on one page.",
  "icon": "👋",
  "category": "examples",
  "tags": [
    "demo",
    "reference",
    "guestbook",
    "rooms",
    "ai"
  ],
  "permalink": {
    "collection": "hello_guestbook",
    "param": "id",
    "title": "{message}",
    "description": "{message}"
  },
  "ai": {
    "models": ["gemini-flash"],
    "maxChars": 500,
    "maxTokens": 300,
    "messagePatterns": {
      "system": "^You greet people warmly in one short sentence\\.$",
      "user": "^Say hello to .{1,80}!$"
    }
  }
}
