{
  "name": "cubby",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#core": "./foundation/src/core/index.js"
  },
  "description": "Micro app host on PocketHost: many tiny static web apps, one PocketBase instance.",
  "license": "MIT",
  "repository": "https://github.com/patsissons/cubby",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:foundation && npm run build:manifest",
    "build:foundation": "node foundation/build.mjs",
    "build:manifest": "node scripts/build-manifest.mjs",
    "new-app": "node scripts/new-app.mjs",
    "test": "npm run test:core && npm run test:markdown && npm run test:widgets && npm run test:mcp && npm run test:content",
    "test:core": "node scripts/core-tests.mjs",
    "test:widgets": "node scripts/widget-tests.mjs",
    "test:markdown": "node scripts/markdown-tests.mjs",
    "test:mcp": "node scripts/mcp-tests.mjs",
    "test:content": "node scripts/content-tests.mjs",
    "seed": "node scripts/seed.mjs",
    "deploy": "phio deploy -v"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eventsource": "^5.1.0",
    "jsdom": "^30.0.1",
    "pocketbase": "^0.27.3"
  }
}
